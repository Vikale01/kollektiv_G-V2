 267:USB_Device/App/usbd_cdc_if.c **** /**
 268:USB_Device/App/usbd_cdc_if.c ****   * @brief  Data received over USB OUT endpoint are sent over CDC interface
 269:USB_Device/App/usbd_cdc_if.c ****   *         through this function.
 270:USB_Device/App/usbd_cdc_if.c ****   *
 271:USB_Device/App/usbd_cdc_if.c ****   *         @note
 272:USB_Device/App/usbd_cdc_if.c ****   *         This function will issue a NAK packet on any OUT packet received on
 273:USB_Device/App/usbd_cdc_if.c ****   *         USB endpoint until exiting this function. If you exit this function
 274:USB_Device/App/usbd_cdc_if.c ****   *         before transfer is complete on CDC interface (ie. using DMA controller)
 275:USB_Device/App/usbd_cdc_if.c ****   *         it will result in receiving more data while previous ones are still
 276:USB_Device/App/usbd_cdc_if.c ****   *         not sent.
 277:USB_Device/App/usbd_cdc_if.c ****   *
 278:USB_Device/App/usbd_cdc_if.c ****   * @param  Buf: Buffer of data to be received
 279:USB_Device/App/usbd_cdc_if.c ****   * @param  Len: Number of data received (in bytes)
 280:USB_Device/App/usbd_cdc_if.c ****   * @retval Result of the operation: USBD_OK if all operations are OK else USBD_FAIL
 281:USB_Device/App/usbd_cdc_if.c ****   */
 282:USB_Device/App/usbd_cdc_if.c **** static int8_t CDC_Receive_FS(uint8_t* Buf, uint32_t *Len)
 283:USB_Device/App/usbd_cdc_if.c **** {
 284:USB_Device/App/usbd_cdc_if.c ****   /* USER CODE BEGIN 6 */
 285:USB_Device/App/usbd_cdc_if.c ****   USBD_CDC_SetRxBuffer(&hUsbDeviceFS, &Buf[0]);
 286:USB_Device/App/usbd_cdc_if.c ****   USBD_CDC_ReceivePacket(&hUsbDeviceFS);
 287:USB_Device/App/usbd_cdc_if.c ****   return (USBD_OK);
 288:USB_Device/App/usbd_cdc_if.c ****   /* USER CODE END 6 */
 289:USB_Device/App/usbd_cdc_if.c **** }
 290:USB_Device/App/usbd_cdc_if.c **** 
 291:USB_Device/App/usbd_cdc_if.c **** /**
 292:USB_Device/App/usbd_cdc_if.c ****   * @brief  CDC_Transmit_FS
 293:USB_Device/App/usbd_cdc_if.c ****   *         Data to send over USB IN endpoint are sent over CDC interface
 294:USB_Device/App/usbd_cdc_if.c ****   *         through this function.
 295:USB_Device/App/usbd_cdc_if.c ****   *         @note
 296:USB_Device/App/usbd_cdc_if.c ****   *
 297:USB_Device/App/usbd_cdc_if.c ****   *
 298:USB_Device/App/usbd_cdc_if.c ****   * @param  Buf: Buffer of data to be sent
 299:USB_Device/App/usbd_cdc_if.c ****   * @param  Len: Number of data to be sent (in bytes)
 300:USB_Device/App/usbd_cdc_if.c ****   * @retval USBD_OK if all operations are OK else USBD_FAIL or USBD_BUSY
ARM GAS  C:\Users\bku598\AppData\Local\Temp\ccJTevsK.s 			page 10


 301:USB_Device/App/usbd_cdc_if.c ****   */
 302:USB_Device/App/usbd_cdc_if.c **** uint8_t CDC_Transmit_FS(uint8_t* Buf, uint16_t Len)
 303:USB_Device/App/usbd_cdc_if.c **** {
 304:USB_Device/App/usbd_cdc_if.c ****   uint8_t result = USBD_OK;
 305:USB_Device/App/usbd_cdc_if.c ****   /* USER CODE BEGIN 7 */
 306:USB_Device/App/usbd_cdc_if.c ****   USBD_CDC_HandleTypeDef *hcdc = (USBD_CDC_HandleTypeDef*)hUsbDeviceFS.pClassData;
 307:USB_Device/App/usbd_cdc_if.c ****   if (hcdc->TxState != 0){
 308:USB_Device/App/usbd_cdc_if.c ****     return USBD_BUSY;
 309:USB_Device/App/usbd_cdc_if.c ****   }
 310:USB_Device/App/usbd_cdc_if.c ****   USBD_CDC_SetTxBuffer(&hUsbDeviceFS, Buf, Len);
 311:USB_Device/App/usbd_cdc_if.c ****   result = USBD_CDC_TransmitPacket(&hUsbDeviceFS);
 312:USB_Device/App/usbd_cdc_if.c ****   /* USER CODE END 7 */
 313:USB_Device/App/usbd_cdc_if.c ****   return result;
 314:USB_Device/App/usbd_cdc_if.c **** }
