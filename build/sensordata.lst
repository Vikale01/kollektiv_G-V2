  59:Core/Src/sensordata.c **** /**
  60:Core/Src/sensordata.c ****  * @brief  Appends IMU data to the RAM buffer. 
  61:Core/Src/sensordata.c ****  * Starts a new page with a header if the buffer is empty.
  62:Core/Src/sensordata.c ****  */
  63:Core/Src/sensordata.c **** void packageDataToMem(void)
  64:Core/Src/sensordata.c **** {
  65:Core/Src/sensordata.c ****   // Put header values ONCE first in buffer
  66:Core/Src/sensordata.c ****   if(bufferPointer == 0)
  67:Core/Src/sensordata.c ****   {
  68:Core/Src/sensordata.c ****     packageHeader(); 
  69:Core/Src/sensordata.c ****     memcpy(buffer, headerBuffer, sizeof(headerBuffer));
  70:Core/Src/sensordata.c ****     bufferPointer += HEADER_SIZE;
  71:Core/Src/sensordata.c ****     dataCounter = 0;
  72:Core/Src/sensordata.c ****   }
  73:Core/Src/sensordata.c **** 
  74:Core/Src/sensordata.c ****   if(dataCounter < BMI_SAMPLES_PER_PAGE)
  75:Core/Src/sensordata.c ****   {
  76:Core/Src/sensordata.c ****     BMI270_ReadMeasurement_raw(BMIraw_data);  // Read data from sensor
  77:Core/Src/sensordata.c **** 
  78:Core/Src/sensordata.c ****     memcpy(buffer + bufferPointer, BMIraw_data, sizeof(BMIraw_data)); // put data on the buffer. 
  79:Core/Src/sensordata.c **** 
  80:Core/Src/sensordata.c ****     bufferPointer += 12; 
  81:Core/Src/sensordata.c ****     dataCounter++;
  82:Core/Src/sensordata.c ****   }
  83:Core/Src/sensordata.c ****   else
  84:Core/Src/sensordata.c ****   { 
  85:Core/Src/sensordata.c ****     bufferFull = true;
  86:Core/Src/sensordata.c ****   }
  87:Core/Src/sensordata.c **** }
  88:Core/Src/sensordata.c **** 
