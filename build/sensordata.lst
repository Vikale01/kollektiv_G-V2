 108:Core/Src/sensordata.c **** /**
 109:Core/Src/sensordata.c ****  * @brief  Writes the full RAM buffer to Flash memory.
 110:Core/Src/sensordata.c ****  * Includes a 4-byte Page ID at the end for recovery/tracking.
 111:Core/Src/sensordata.c ****  */
 112:Core/Src/sensordata.c **** void sendPackageToMem(void)
 113:Core/Src/sensordata.c **** {
 114:Core/Src/sensordata.c ****   if(!bufferFull){return;}
 115:Core/Src/sensordata.c **** 
 116:Core/Src/sensordata.c ****   newSectionCheck();  // Check if we are in a new section in the memory (One section is 4096 bytes)
 117:Core/Src/sensordata.c **** 
 118:Core/Src/sensordata.c ****   buffer[BUFFER_SIZE - 4] = (addInc >> 24) & 0xFF;
 119:Core/Src/sensordata.c ****   buffer[BUFFER_SIZE - 3] = (addInc >> 16) & 0xFF;
 120:Core/Src/sensordata.c ****   buffer[BUFFER_SIZE - 2] = (addInc >> 8) & 0xFF;
 121:Core/Src/sensordata.c ****   buffer[BUFFER_SIZE - 1] = addInc & 0xFF;
 122:Core/Src/sensordata.c **** 
 123:Core/Src/sensordata.c ****   Flash_Write4Page((sectorCounter * 16) + pageCounter, buffer, BUFFER_SIZE);
 124:Core/Src/sensordata.c **** 
 125:Core/Src/sensordata.c ****   pageCounter++;
 126:Core/Src/sensordata.c ****   addInc++;
 127:Core/Src/sensordata.c **** 
 128:Core/Src/sensordata.c ****   bufferPointer = 0;
 129:Core/Src/sensordata.c ****   dataCounter = 0;
 130:Core/Src/sensordata.c ****   bufferFull = false;
 131:Core/Src/sensordata.c ****   memset(buffer, 0xFF, BUFFER_SIZE);
 132:Core/Src/sensordata.c **** }
 133:Core/Src/sensordata.c **** 
 134:Core/Src/sensordata.c **** /**
 135:Core/Src/sensordata.c ****  * @brief  Scans Flash memory on boot to find the last written page.
 136:Core/Src/sensordata.c ****  * Enables the system to resume logging without overwriting old data.
 137:Core/Src/sensordata.c ****  */
 138:Core/Src/sensordata.c **** void findStartPos(void)
 139:Core/Src/sensordata.c **** {
 140:Core/Src/sensordata.c ****     uint8_t pageIdBytes[4];
 141:Core/Src/sensordata.c **** 
 142:Core/Src/sensordata.c ****     for (uint32_t i = 0; i < PAGE_IN_MEMORY; i++)
ARM GAS  C:\Users\bku598\AppData\Local\Temp\ccWEe5Lj.s 			page 6


 143:Core/Src/sensordata.c ****     {
 144:Core/Src/sensordata.c ****         // only read the last 4 bytes. 
 145:Core/Src/sensordata.c ****         Flash_NormalRead(i * BUFFER_SIZE + (BUFFER_SIZE - 4), pageIdBytes, 4);
 146:Core/Src/sensordata.c **** 
 147:Core/Src/sensordata.c ****         uint32_t pageId = ((uint32_t)pageIdBytes[0] << 24) |
 148:Core/Src/sensordata.c ****                           ((uint32_t)pageIdBytes[1] << 16) |
 149:Core/Src/sensordata.c ****                           ((uint32_t)pageIdBytes[2] << 8)  |
 150:Core/Src/sensordata.c ****                           ((uint32_t)pageIdBytes[3]);
 151:Core/Src/sensordata.c **** 
 152:Core/Src/sensordata.c ****         if (pageId == 0xFFFFFFFF)
 153:Core/Src/sensordata.c ****         {
 154:Core/Src/sensordata.c ****             if (i == 0)
 155:Core/Src/sensordata.c ****             {
 156:Core/Src/sensordata.c ****                 // Flash is empty
 157:Core/Src/sensordata.c ****                 addInc = 0;
 158:Core/Src/sensordata.c ****                 pageCounter = 0;
 159:Core/Src/sensordata.c ****                 sectorCounter = 0;
 160:Core/Src/sensordata.c ****             }
 161:Core/Src/sensordata.c ****             else
 162:Core/Src/sensordata.c ****             {
 163:Core/Src/sensordata.c ****                 // Read last page
 164:Core/Src/sensordata.c ****                 Flash_NormalRead((i - 1) * BUFFER_SIZE + (BUFFER_SIZE - 4), pageIdBytes, 4);
 165:Core/Src/sensordata.c **** 
 166:Core/Src/sensordata.c ****                 pageId = ((uint32_t)pageIdBytes[0] << 24) |
 167:Core/Src/sensordata.c ****                          ((uint32_t)pageIdBytes[1] << 16) |
 168:Core/Src/sensordata.c ****                          ((uint32_t)pageIdBytes[2] << 8)  |
 169:Core/Src/sensordata.c ****                          ((uint32_t)pageIdBytes[3]);
 170:Core/Src/sensordata.c **** 
 171:Core/Src/sensordata.c ****                 // Last written page is i-1
 172:Core/Src/sensordata.c ****                 addInc = pageId + 1;
 173:Core/Src/sensordata.c ****                 pageCounter = (i % PAGE_PER_SECTION);
 174:Core/Src/sensordata.c ****                 sectorCounter = (i / PAGE_PER_SECTION);
 175:Core/Src/sensordata.c ****             }
 176:Core/Src/sensordata.c ****             return;
 177:Core/Src/sensordata.c ****         }
 178:Core/Src/sensordata.c ****     }
 179:Core/Src/sensordata.c **** 
 180:Core/Src/sensordata.c ****     // All pages used
 181:Core/Src/sensordata.c ****     addInc = PAGE_IN_MEMORY;
 182:Core/Src/sensordata.c ****     pageCounter = PAGE_IN_MEMORY % PAGE_PER_SECTION;
 183:Core/Src/sensordata.c ****     sectorCounter = PAGE_IN_MEMORY / PAGE_PER_SECTION;
 184:Core/Src/sensordata.c **** }
