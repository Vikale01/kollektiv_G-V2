  95:Core/Src/sensordata.c **** 
  96:Core/Src/sensordata.c **** void sendPackageToMem(void)
  97:Core/Src/sensordata.c **** {
  98:Core/Src/sensordata.c ****   if(!bufferFull){return;}
  99:Core/Src/sensordata.c **** 
 100:Core/Src/sensordata.c ****   newSectionCheck();  // Check if we are in a new section in the memory (One section is 4096 bytes)
 101:Core/Src/sensordata.c **** 
 102:Core/Src/sensordata.c ****   buffer[BUFFER_SIZE - 4] = (addInc >> 24) & 0xFF;
 103:Core/Src/sensordata.c ****   buffer[BUFFER_SIZE - 3] = (addInc >> 16) & 0xFF;
 104:Core/Src/sensordata.c ****   buffer[BUFFER_SIZE - 2] = (addInc >> 8) & 0xFF;
 105:Core/Src/sensordata.c ****   buffer[BUFFER_SIZE - 1] = addInc & 0xFF;
 106:Core/Src/sensordata.c **** 
 107:Core/Src/sensordata.c ****   Flash_Write4Page((sectorCounter * 16) + pageCounter, buffer, BUFFER_SIZE);
 108:Core/Src/sensordata.c **** 
 109:Core/Src/sensordata.c ****   pageCounter++;
 110:Core/Src/sensordata.c ****   addInc++;
 111:Core/Src/sensordata.c **** 
 112:Core/Src/sensordata.c ****   bufferPointer = 0;
 113:Core/Src/sensordata.c ****   dataCounter = 0;
 114:Core/Src/sensordata.c ****   bufferFull = false;
 115:Core/Src/sensordata.c ****   memset(buffer, 0xFF, BUFFER_SIZE);
 116:Core/Src/sensordata.c **** }
 117:Core/Src/sensordata.c **** 
 118:Core/Src/sensordata.c **** // Function to find the last written page in flash
 119:Core/Src/sensordata.c **** void findStartPos(void)
 120:Core/Src/sensordata.c **** {
 121:Core/Src/sensordata.c ****     uint8_t pageIdBytes[4];
 122:Core/Src/sensordata.c **** 
 123:Core/Src/sensordata.c ****     for (uint32_t i = 0; i < PAGE_IN_MEMORY; i++)
 124:Core/Src/sensordata.c ****     {
 125:Core/Src/sensordata.c ****         // Läs bara de sista 4 bytena från sidan
 126:Core/Src/sensordata.c ****         Flash_NormalRead(i * BUFFER_SIZE + (BUFFER_SIZE - 4), pageIdBytes, 4);
 127:Core/Src/sensordata.c **** 
 128:Core/Src/sensordata.c ****         uint32_t pageId = ((uint32_t)pageIdBytes[0] << 24) |
 129:Core/Src/sensordata.c ****                           ((uint32_t)pageIdBytes[1] << 16) |
 130:Core/Src/sensordata.c ****                           ((uint32_t)pageIdBytes[2] << 8)  |
 131:Core/Src/sensordata.c ****                           ((uint32_t)pageIdBytes[3]);
 132:Core/Src/sensordata.c **** 
 133:Core/Src/sensordata.c ****         if (pageId == 0xFFFFFFFF)
 134:Core/Src/sensordata.c ****         {
 135:Core/Src/sensordata.c ****             if (i == 0)
 136:Core/Src/sensordata.c ****             {
 137:Core/Src/sensordata.c ****                 // Flash är tom
 138:Core/Src/sensordata.c ****                 addInc = 0;
 139:Core/Src/sensordata.c ****                 pageCounter = 0;
 140:Core/Src/sensordata.c ****                 sectorCounter = 0;
 141:Core/Src/sensordata.c ****             }
 142:Core/Src/sensordata.c ****             else
ARM GAS  C:\Users\bku598\AppData\Local\Temp\ccavmmSw.s 			page 6


 143:Core/Src/sensordata.c ****             {
 144:Core/Src/sensordata.c ****                 // Läs sista sidan
 145:Core/Src/sensordata.c ****                 Flash_NormalRead((i - 1) * BUFFER_SIZE + (BUFFER_SIZE - 4), pageIdBytes, 4);
 146:Core/Src/sensordata.c **** 
 147:Core/Src/sensordata.c ****                 pageId = ((uint32_t)pageIdBytes[0] << 24) |
 148:Core/Src/sensordata.c ****                          ((uint32_t)pageIdBytes[1] << 16) |
 149:Core/Src/sensordata.c ****                          ((uint32_t)pageIdBytes[2] << 8)  |
 150:Core/Src/sensordata.c ****                          ((uint32_t)pageIdBytes[3]);
 151:Core/Src/sensordata.c **** 
 152:Core/Src/sensordata.c ****                 // Senast skrivna sidan är i-1
 153:Core/Src/sensordata.c ****                 addInc = pageId + 1;
 154:Core/Src/sensordata.c ****                 pageCounter = (i % PAGE_PER_SECTION);
 155:Core/Src/sensordata.c ****                 sectorCounter = (i / PAGE_PER_SECTION);
 156:Core/Src/sensordata.c ****             }
 157:Core/Src/sensordata.c ****             return;
 158:Core/Src/sensordata.c ****         }
 159:Core/Src/sensordata.c ****     }
 160:Core/Src/sensordata.c **** 
 161:Core/Src/sensordata.c ****     // Alla sidor använda
 162:Core/Src/sensordata.c ****     addInc = PAGE_IN_MEMORY;
 163:Core/Src/sensordata.c ****     pageCounter = PAGE_IN_MEMORY % PAGE_PER_SECTION;
 164:Core/Src/sensordata.c ****     sectorCounter = PAGE_IN_MEMORY / PAGE_PER_SECTION;
 165:Core/Src/sensordata.c **** }
