  30:Core/Src/gps.c **** /**
  31:Core/Src/gps.c ****  * @brief  Verify UBX checksum
  32:Core/Src/gps.c ****  * @return True if checksum is valid
  33:Core/Src/gps.c ****  */
  34:Core/Src/gps.c **** static uint8_t checkSum(volatile uint8_t *p)
  35:Core/Src/gps.c **** {
  36:Core/Src/gps.c ****     uint8_t ck_a = 0, ck_b = 0;
  37:Core/Src/gps.c **** 
  38:Core/Src/gps.c ****     /* Checking if buffer received is correctly structured */
  39:Core/Src/gps.c ****     for (int i = CHECKSUM_SP; i <= CHECKSUM_EP; i++) {
  40:Core/Src/gps.c ****         ck_a += p[i];
  41:Core/Src/gps.c ****         ck_b += ck_a;
  42:Core/Src/gps.c ****     }
  43:Core/Src/gps.c ****     if((ck_a == p[98]) && (ck_b == p[99])) return 1;
  44:Core/Src/gps.c ****     return 0;
  45:Core/Src/gps.c **** }
